  <worksheets>
    <worksheet name='Age Band Stacked Bar'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#ffffff' fontname='Tableau Semibold'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='GBD_Asthma_Final (Cleaned Data)' name='federated.0pjjdjv1lwudwb1fi91c61ofosnn' />
          </datasources>
          <datasource-dependencies datasource='federated.0pjjdjv1lwudwb1fi91c61ofosnn'>
            <column caption='Filter: Is Age Aggregate' datatype='boolean' name='[Calculation_2196846970896401]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[age_name] = &quot;All ages&quot; OR [age_name] = &quot;Age-standardized&quot;' />
            </column>
            <column caption='Filter: Is Age Band' datatype='boolean' name='[Calculation_2196846970970130]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='NOT [Calculation_2196846970896401]' />
            </column>
            <column caption='Fmt: Stacked Percent' datatype='real' name='[Calculation_2196847725412388]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([val_display]) / TOTAL(SUM([val_display]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Age Name' datatype='string' name='[age_name]' role='dimension' type='nominal' />
            <column caption='Measure Name' datatype='string' name='[measure_name]' role='dimension' type='nominal' />
            <column caption='Metric Name' datatype='string' name='[metric_name]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_2196846970970130]' derivation='None' name='[none:Calculation_2196846970970130:nk]' pivot='key' type='nominal' />
            <column-instance column='[age_name]' derivation='None' name='[none:age_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[measure_name]' derivation='None' name='[none:measure_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[metric_name]' derivation='None' name='[none:metric_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[sex_name]' derivation='None' name='[none:sex_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[year]' derivation='None' name='[none:year:qk]' pivot='key' type='quantitative' />
            <column caption='Sex Name' datatype='string' name='[sex_name]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_2196847725412388]' derivation='User' name='[usr:Calculation_2196847725412388:qk:2]' pivot='key' type='quantitative'>
              <table-calc ordering-field='[federated.0pjjdjv1lwudwb1fi91c61ofosnn].[age_name]' ordering-type='Field' />
            </column-instance>
            <column caption='Val Display' datatype='real' name='[val_display]' role='measure' type='quantitative' />
