      <aliases enabled='yes' />
      <column caption='Display Value' datatype='real' name='[Calculation_2196846957285377]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[val_display]' />
      </column>
      <column caption='Core: Combined Sex Total' datatype='real' name='[Calculation_2196846961315842]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [year], [location_name], [age_name], [measure_name], [metric_name] : &#13;&#10;SUM([Calculation_2196846957285377]) }' />
      </column>
      <column caption='Core: Sex Gap' datatype='real' name='[Calculation_2196846961852419]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ABS(&#13;&#10;  { FIXED [year], [location_name], [measure_name], [metric_name] : &#13;&#10;  SUM(IF [sex_name] = &quot;Male&quot; THEN [Calculation_2196846957285377] END) }&#13;&#10;  -&#13;&#10;  { FIXED [year], [location_name], [measure_name], [metric_name] : &#13;&#10;  SUM(IF [sex_name] = &quot;Female&quot; THEN [Calculation_2196846957285377] END) }&#13;&#10;)' />
      </column>
      <column caption='Fmt: Abbreviated Value' datatype='string' name='[Calculation_2196846962110468]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ABS([Calculation_2196847001653272]) &gt;= 1000000 THEN STR(ROUND([Calculation_2196847001653272]/1000000,1)) + &quot;M&quot;&#13;&#10;ELSEIF ABS([Calculation_2196847001653272]) &gt;= 1000 THEN STR(ROUND([Calculation_2196847001653272]/1000,1)) + &quot;K&quot;&#13;&#10;ELSE STR(ROUND([Calculation_2196847001653272],1))&#13;&#10;END' />
      </column>
      <column caption='Fmt: Unit Suffix' datatype='string' name='[Calculation_2196846962622469]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [metric_name] WHEN &quot;Number&quot; THEN &quot; cases&quot; WHEN &quot;Rate&quot; THEN &quot; per 100k&quot; WHEN &quot;Percent&quot; THEN &quot;%&quot; END' />
      </column>
      <column caption='Fmt: Dynamic Title' datatype='string' name='[Calculation_2196846968995847]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IFNULL(ATTR([measure_name]), &quot;All Measures&quot;) + &quot; — &quot; + IFNULL(ATTR([metric_name]), &quot;All Metrics&quot;) +&#13;&#10;&quot; (&quot; + STR(MIN([year])) + &quot;–&quot; + STR(MAX([year])) + &quot;)&quot;' />
      </column>
      <column caption='Rank: Country' datatype='integer' name='[Calculation_2196846969266184]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK([Calculation_2196847001653272])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Rank: Top N Flag' datatype='string' name='[Calculation_2196846969475081]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_2196846969266184] &lt;= 5 THEN &quot;Top N&quot; ELSE &quot;Other&quot; END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Time: YoY % Change' datatype='real' name='[Calculation_2196846969618442]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='( [Calculation_2196847001653272] - LOOKUP([Calculation_2196847001653272], -1) )&#13;&#10;/ ABS(LOOKUP([Calculation_2196847001653272], -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Time: Moving Avg (3yr)' datatype='real' name='[Calculation_2196846970023947]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG([Calculation_2196847001653272], -2, 0)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Time: CAGR ' datatype='real' name='[Calculation_2196846970138636]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN([Calculation_2196846971199509]) / ZN([Calculation_2196846971306006]))&#13;&#10;^ (1 / ({ FIXED : MAX([year]) } - { FIXED : MIN([year]) })) - 1' />
      </column>
      <column caption='Risk: Above Average Flag' datatype='boolean' name='[Calculation_2196846970327053]' role='measure' type='nominal'>
        <calculation class='tableau' formula='[Calculation_2196847001653272] &gt; WINDOW_AVG([Calculation_2196847001653272])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Risk: Z-Score' datatype='real' name='[Calculation_2196846970458126]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_2196847001653272] - WINDOW_AVG([Calculation_2196847001653272]))&#13;&#10;/ WINDOW_STDEV([Calculation_2196847001653272])'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Geo: Unmatched Flag' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_2196846970572815]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF(ISNULL([Location Name (copy)_2196846970728464]), &quot;Check spelling&quot;, &quot;OK&quot;)' />
      </column>
      <column caption='Filter: Is Age Aggregate' datatype='boolean' name='[Calculation_2196846970896401]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[age_name] = &quot;All ages&quot; OR [age_name] = &quot;Age-standardized&quot;' />
      </column>
      <column caption='Filter: Is Age Band' datatype='boolean' name='[Calculation_2196846970970130]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='NOT [Calculation_2196846970896401]' />
      </column>
      <column caption='Filter: Is Age Standardized' datatype='boolean' name='[Calculation_2196846971039763]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[age_name] = &quot;Age-standardized&quot;' />
      </column>
      <column caption='Dash: Selected Country Label' datatype='string' name='[Calculation_2196846971117588]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL(ATTR([location_name])) THEN &quot;All Countries&quot; ELSE ATTR([location_name]) END' />
      </column>
      <column caption='L: Latest Year Value' datatype='real' name='[Calculation_2196846971199509]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [location_name], [measure_name], [metric_name] :&#13;&#10;MAX(IF [year] = { FIXED : MAX([year]) } THEN [Calculation_2196846957285377] END) }' />
      </column>
      <column caption='L: First Year Value' datatype='real' name='[Calculation_2196846971306006]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [location_name], [measure_name], [metric_name] :&#13;&#10;MAX(IF [year] = { FIXED : MIN([year]) } THEN [Calculation_2196846957285377] END) }' />
      </column>
      <column caption='L: Global Total (Fixed)' datatype='real' name='[Calculation_2196846971400215]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : SUM([Calculation_2196846957285377]) }' />
      </column>
      <column caption='Core: Display Value' datatype='real' name='[Calculation_2196847001653272]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ATTR([metric_name]) = &quot;Number&quot; THEN &#13;&#10;    SUM([val_display])&#13;&#10;ELSE &#13;&#10;    AVG([val_display])&#13;&#10;END' />
      </column>
      <column caption='Agg: YoY Text' datatype='string' name='[Calculation_2196847001980953]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_2196846969618442] &gt; 0 THEN &quot;+&quot; + STR(ROUND([Calculation_2196846969618442]*100, 1)) + &quot;% ▲&quot;&#13;&#10;ELSEIF [Calculation_2196846969618442] &lt; 0 THEN STR(ROUND([Calculation_2196846969618442]*100, 1)) + &quot;% ▼&quot;&#13;&#10;ELSEIF [Calculation_2196846969618442] = 0 THEN &quot;0.0%&quot;&#13;&#10;ELSE &quot;&quot;&#13;&#10;END'>
