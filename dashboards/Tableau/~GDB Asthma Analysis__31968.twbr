    <worksheet name='Risk: Above-Average Bar '>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#ffffff' fontname='Tableau Semibold'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='GBD_Asthma_Final (Cleaned Data)' name='federated.0pjjdjv1lwudwb1fi91c61ofosnn' />
          </datasources>
          <datasource-dependencies datasource='federated.0pjjdjv1lwudwb1fi91c61ofosnn'>
            <column caption='Risk: Above Average Flag' datatype='boolean' name='[Calculation_2196846970327053]' role='measure' type='nominal'>
              <calculation class='tableau' formula='[Calculation_2196847001653272] &gt; WINDOW_AVG([Calculation_2196847001653272])'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Risk: Z-Score' datatype='real' name='[Calculation_2196846970458126]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_2196847001653272] - WINDOW_AVG([Calculation_2196847001653272]))&#13;&#10;/ WINDOW_STDEV([Calculation_2196847001653272])'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Core: Display Value' datatype='real' name='[Calculation_2196847001653272]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF ATTR([metric_name]) = &quot;Number&quot; THEN &#13;&#10;    SUM([val_display])&#13;&#10;ELSE &#13;&#10;    AVG([val_display])&#13;&#10;END' />
