      <column caption='Pyramid: Signed Value' datatype='real' name='[Calculation_2196847676842015]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [sex_name] = &quot;Male&quot; THEN -[val] ELSE [val] END' />
